# ============================================================================
# Environment Variables Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!
# ============================================================================

# GitHub API Token (required)
# Get yours at: https://github.com/settings/tokens
# Required scopes: repo (for private repos) or public_repo (for public repos)
GITHUB_TOKEN=your_github_token_here

# ============================================================================
# Email Configuration (optional - for email reports)
# ============================================================================

# SMTP Server settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# SMTP Authentication
# For Gmail, use an App Password: https://myaccount.google.com/apppasswords
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Sender email (defaults to SMTP_USERNAME if not set)
EMAIL_FROM=your-email@gmail.com

# ============================================================================
# Team Email Recipients (comma-separated)
# ============================================================================
# List of email addresses to receive the weekly report
TEAM_EMAILS=user1@example.com,user2@example.com,user3@example.com

# ============================================================================
# Secrets Provider Configuration (optional)
# ============================================================================

# Backend to use for secrets. Options: 'env' (default) or 'gcp'
# SECRET_BACKEND=env

# If SECRET_BACKEND is 'gcp', specify the Google Cloud Project ID:
# GCP_PROJECT_ID=my-gcp-project-123

# ============================================================================
# Optional Configuration
# ============================================================================

# Debug mode (set to 'true' to enable verbose logging)
DEBUG=false

# Analysis confidence threshold (0-100)
# MIN_CONFIDENCE_THRESHOLD=75
